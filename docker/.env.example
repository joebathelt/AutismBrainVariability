# Copy to docker/.env and adjust.
# Absolute path the data/ symlinks resolve to. Find it with:
#   readlink -f ../data/HCP_PTN1200
# If data/ holds real directories rather than symlinks, use ../data
HCP_DATA_ROOT=/absolute/path/to/your/data
# Your UID/GID, so outputs are not written as root:  id -u   /   id -g
# Leave both empty under rootless Docker - container root already maps to you.
HOST_UID=1000
HOST_GID=1000
CORES=8
MEM_MB=16000
