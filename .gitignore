# ===========================================================================
# Repository scope
#
# This repo tracks the ANALYSIS CODE and the CONTAINER that runs it.
# It deliberately tracks no data and no generated outputs.
# ===========================================================================

# --- Data: never commit -----------------------------------------------------
# HCP imaging/behavioural data is governed by the HCP Data Use Agreement, the
# genotypes are restricted-access, and the PGC summary statistics have their
# own terms. data/ also holds symlinks into a local checkout and ~1.5 GB of
# PLINK/plinkQC intermediates.
data/

# --- Generated outputs: reproducible by running the pipeline ----------------
figures/
results/
reports/
logs/
archive/

# --- Manuscript -------------------------------------------------------------
# Not currently published. To include the LaTeX sources, delete this line and
# run:  git add manuscript/*.tex manuscript/*.bib manuscript/*.cls manuscript/*.bst
manuscript/

# --- Workflow / container state ---------------------------------------------
.snakemake/
.docker/
snakemake.log

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# --- R ----------------------------------------------------------------------
.Rhistory
.RData
.Rproj.user/
Rplots.pdf

# --- Editors / OS -----------------------------------------------------------
.claude/
.vscode/
.idea/
.DS_Store
__MACOSX/
._*
.Spotlight-V100
.Trashes

# --- Backups ----------------------------------------------------------------
*.bak
*.orig
